# Скопируйте в .env и заполните. Файл .env НЕЛЬЗЯ коммитить.
APP_ENV=development
SECRET_KEY=
DATABASE_PATH=instance/teacherai.db
PUBLIC_URL=http://127.0.0.1:5000

# --- AI ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=
AI_TIMEOUT=180
AI_MAX_TOKENS=8000
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
DAILY_GENERATION_LIMIT=30
TZ_OFFSET_HOURS=3

# --- Первый администратор (manage.py create-admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# --- Почта для восстановления доступа (необязательно) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
